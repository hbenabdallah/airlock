# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> airlock ###
# Where commands may write and what they may read: auto (sandboxed), strict (sandboxed, no network) or off.
AIRLOCK_SANDBOX=auto
# Seconds a command may run before it is stopped.
AIRLOCK_TIMEOUT=120
# Key signing the state of a pending approval, at least 32 bytes; empty, each process makes its own.
AIRLOCK_STATE_KEY=
###< airlock ###

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###

###> symfony/ai-generic-platform ###
# Key for NVIDIA's API catalog (build.nvidia.com), read by the output check and the risk line. Empty, both are off:
# commands still run, the output is marked as not checked and the form shows only the rule. Put the real key in
# .env.local, never here.
AIRLOCK_NVIDIA_API_KEY=
# Reads a command's output and says whether it holds a prompt injection (structured output: clean or injection).
AIRLOCK_OUTPUT_CHECK_MODEL=minimaxai/minimax-m3.1-flash
# Writes the one line in plain words shown in the form of a command asked every time (structured output).
AIRLOCK_RISK_MODEL=nvidia/nemotron-3.5-bolt-e4b
# Seconds a model may take to answer before Airlock goes on without it.
AIRLOCK_MODEL_TIMEOUT=8
###< symfony/ai-generic-platform ###
